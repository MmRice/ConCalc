<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.mmrice.concalc"
    android:versionCode="24"
    android:versionName="2.0">

    <!-- v1.18: the VIBRATE permission is the one permission this app
       asks for. The WebView vibration API (navigator.vibrate, used
       for the short haptic pulse on key presses) is gated on it —
       without the declaration the call is a silent no-op. It is a
       normal permission, granted automatically at install, no
       runtime prompt. Still fully offline: no internet, no Google
       services, no other permissions. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <uses-sdk android:minSdkVersion="21" android:targetSdkVersion="33" />

    <application
        android:label="ConCalc"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@android:style/Theme.Material.Light.NoActionBar"
        android:allowBackup="false">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
